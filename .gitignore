.venv*/
__pycache__/
*.pyc
.cache/
.DS_Store
.env

# Local ROCm wheel cache (large binaries, do not commit)
rocm-wheels/

# Local logs / captures
*.log

# Medical data (never commit raw medical data or derived datasets).
# The de-identified LIDC patient-holdout split manifest is governance
# metadata (patient IDs + series dirs, no pixels) and IS tracked.
data/*
!data/mvp/
data/mvp/*
!data/mvp/split_manifest_lidc_patientholdout.json

# Common medical imaging formats (raw)
*.dcm
*.dicom
*.nii
*.nii.gz
*.mhd
*.nrrd

# Derived images (scoped to data folder only)
data/**/*.png
data/**/*.jpg
data/**/*.jpeg

# Training runs and checkpoints
runs
runs/
checkpoints/
.worktrees/

# LoRA adapter weights — live on NAS + HF Hub, not git (see docs/git-workflow.md)
adapters/

# Model binaries in release envelopes — keep the TEXT evidence, not the weights
*.safetensors
*.pth
*.pt
*.onnx

# Scratch metrics / tunable-op tuning dumps at repo root
tunableop_results*.csv
